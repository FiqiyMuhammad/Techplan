# ==========================================
# TECHPLAN (TEDU) - ENVIRONMENT VARIABLES
# ==========================================

# 1. DATABASE (PostgreSQL / Supabase / Neon)
# Pastikan menggunakan connection pooling untuk Vercel / Serverless
DATABASE_URL="postgresql://user:password@host:port/dbname?sslmode=require"

# 2. BETTER-AUTH (Authentication Engine)
# Generate secret baru dengan: openssl rand -base64 32
BETTER_AUTH_SECRET="ganti_dengan_random_secret_minimal_32_karakter"
# URL root aplikasi (Gunakan http://localhost:3000 untuk lokal, atau https://techplan-seven.vercel.app untuk Vercel)
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 3. GOOGLE OAUTH CREDENTIALS (Login Google)
# Dapatkan di: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI:
# - http://localhost:3000/api/auth/callback/google
# - https://techplan-seven.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# 4. AI ENGINE PROVIDERS
# Google Gemini (Default Provider): https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY="AIzaSy..."

# Groq (Fallback 1 / Cepat & Gratis): https://console.groq.com/keys
GROQ_API_KEY="gsk_..."

# OpenRouter (Fallback 2 / GPT-4o-mini & Claude): https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-..."
